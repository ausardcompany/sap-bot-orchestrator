{
  "name": "alexi",
  "version": "1.22.17",
  "type": "module",
  "description": "Alexi - Intelligent LLM orchestrator with multi-provider support and auto-routing",
  "main": "dist/index.js",
  "bin": {
    "alexi": "dist/cli/program.js",
    "ax": "dist/cli/program.js"
  },
  "scripts": {
    "dev": "tsx src/cli/program.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/program.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@inquirer/prompts": "^8.7.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@sap-ai-sdk/ai-api": "^2.12.0",
    "@sap-ai-sdk/orchestration": "^2.15.0",
    "@types/node-notifier": "^8.0.5",
    "better-sqlite3": "^13.0.3",
    "cli-highlight": "^2.1.11",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "duck-duck-scrape": "^2.2.7",
    "fzf": "^0.5.2",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.5",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "mammoth": "^1.12.2",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "nanoid": "^6.0.1",
    "node-notifier": "^10.0.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.8",
    "simple-git": "^3.36.0",
    "terminal-image": "^5.0.1",
    "terminal-link": "^5.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-bash": "^0.21.0",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-rust": "^0.23.2",
    "tree-sitter-typescript": "^0.23.2"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    },
    "tree-sitter-bash": {
      "optional": true
    },
    "tree-sitter-go": {
      "optional": true
    },
    "tree-sitter-javascript": {
      "optional": true
    },
    "tree-sitter-python": {
      "optional": true
    },
    "tree-sitter-rust": {
      "optional": true
    },
    "tree-sitter-typescript": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "puppeteer": "^25.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "jszip": "^3.10.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "tsc-files": "^1.1.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "minimatch": "10.2.6"
  },
  "keywords": [
    "llm",
    "ai",
    "orchestrator",
    "chatbot",
    "openai",
    "anthropic",
    "sap",
    "bedrock"
  ],
  "author": "Ausard",
  "license": "MIT"
}
